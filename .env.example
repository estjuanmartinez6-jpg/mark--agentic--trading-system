# ══════════════════════════════════════════════════════════════════
#  MARK III — Order Flow Trading System (.env)
#  Copy this file as .env and fill in your values.
#  NEVER commit the real .env to a public repository.
# ══════════════════════════════════════════════════════════════════

# ─── Modo de operación ───────────────────────────────────────────
# SIGNAL: only generates signals, does NOT execute orders (recommended first)
# AUTO:   executes orders automatically on MT5
TRADING_MODE=SIGNAL

# ─── MetaTrader 5 ────────────────────────────────────────────────
# If MT5 is already open and logged in, you can leave these empty.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# ─── Risk Management ────────────────────────────────────────────
RISK_PER_TRADE=1.0
MAX_DAILY_DRAWDOWN=3.0
MAX_LOSS_PER_TRADE_USD=3.0
MAX_POSITIONS=2
MAX_TRADES_PER_DAY=10

# ─── Strategy Parameters ────────────────────────────────────────
# Delta multiplier: how much stronger than average the delta must be
DELTA_MULTIPLIER=1.5

# Divergence lookback window (number of M5 candles)
DIVERGENCE_LOOKBACK=5

# Minimum ATR to allow trading (filters flat markets)
MIN_ATR_ES=1.0
MIN_ATR_NQ=3.0

# Minimum combined score to trigger a trade (0-100)
MIN_SCORE=65

# ─── Execution Timing ───────────────────────────────────────────
# Signal check interval in seconds
SIGNAL_INTERVAL=15

# Cooldown between signals on same symbol (seconds)
SIGNAL_COOLDOWN=300

# Number of candles to wait before allowing signals
WARMUP_CANDLES=10

# M15 candle history for higher-timeframe trend context.
# Keep this comfortably above EMA50 so trend detection has valid data.
CANDLE_HISTORY_M15=100

# ─── ATR-based SL/TP ────────────────────────────────────────────
ATR_SL_MULT=1.5
ATR_TP_MULT=2.5

# ─── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Telegram Alerts (Optional) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
